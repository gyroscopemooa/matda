{
  "name": "haejyo-matda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-preview.mjs --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "local:admin": "tsx docs/local-admin.ts",
    "dev:test": "node scripts/dev-test.mjs",
    "lint": "eslint src tests scripts docs/local-admin.ts next.config.ts playwright.config.ts",
    "format": "prettier --write src tests scripts next.config.ts playwright.config.ts eslint.config.mjs",
    "preview": "node scripts/dev-preview.mjs",
    "preview:release": "node scripts/dev-preview.mjs --release-preview",
    "check:remote": "node --env-file-if-exists=.env.local scripts/check-remote.mjs",
    "cf:build": "node scripts/build-cloudflare.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.135.0"
  }
}
