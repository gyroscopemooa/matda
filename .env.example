NEXT_PUBLIC_RELEASE_PHASE=1
# Future isolated Phase 2 staging only; leave unset for the current public site.
# Requires SQL 0015-0017 and its separate DB release switch.
# CONSUMER_QUOTES_REMOTE_ENABLED=true
DATA_ADAPTER=local
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3107
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PAYMENTS_ENABLED=false
TENDERS_ENABLED=false
NEXT_PUBLIC_QUOTES_ENABLED=true
NEXT_PUBLIC_PROVIDERS_ENABLED=true
NEXT_PUBLIC_BIZ_ENABLED=true
QUOTE_REQUIRE_PROVIDER_ACCEPTANCE=false
LOCAL_DATA_DIR=.local
LOCAL_SIGNING_SECRET=
ALLOW_LOCAL_PREVIEW=false
# LIVE-SUB HQ runtime notice/maintenance client (browser-only; defaults are the production values).
NEXT_PUBLIC_LIVESUB_RUNTIME_BASE_URLS=https://runtime.live-sub.com
NEXT_PUBLIC_LIVESUB_RUNTIME_ENV=production
